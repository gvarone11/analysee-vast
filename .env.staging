# ============================================================================
# GPU Inference Service - STAGING Environment
# ============================================================================
# Used for staging on RTX 3090 or A100 with full RabbitMQ integration
# ============================================================================

# RabbitMQ - connects to staging backend RabbitMQ
# Update with actual staging broker address
#RABBITMQ_URL= # Injected from secrets

# Model directory
MODEL_CACHE_DIR="models_local"

# GPU enabled - RTX 3090 or A100
GPU_INFERENCE_ENABLED=true
CUDA_VISIBLE_DEVICES=0

# FastAPI server (single worker for GPU stability)
UVICORN_HOST="0.0.0.0"
UVICORN_PORT=8002
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL="info"

# Logging (reduced verbosity)
LOG_LEVEL="INFO"
DEBUG=false
CORRELATION_ID_LOGGING=true

# Models
DEFAULT_MODEL_NAME="v1.2.0"
DEFAULT_INPUT_SIZE=1536
DEFAULT_CONFIDENCE_THRESHOLD=0.5

# Caching (same as production)
MODEL_CACHE_TTL_SECONDS=3600
MODEL_CACHE_MAX_SIZE=10

# RabbitMQ Configuration
PREFETCH_COUNT=1
INFERENCE_RPC_TIMEOUT=60

# Health checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Performance tuning for A100 (40GB VRAM)
# Use batch_size=2 only for A100, keep 1 for RTX 3090
INFERENCE_BATCH_SIZE=1
GPU_MEMORY_FRACTION=0.85

# Development/Testing disabled in staging
SKIP_GPU_VALIDATION=false
MOCK_INFERENCE=false
TEST_MODE=false

# Environment
ENVIRONMENT="staging"
VERSION="2.0.0"
