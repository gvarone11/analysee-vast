# ============================================================================
# GPU Inference Service - PRODUCTION Environment
# ============================================================================
# Used for production deployment on Vast.ai (A100 40GB GPU)
# This file is populated by provisioning.sh
# ============================================================================

# RabbitMQ - reaches backend via host.docker.internal (Docker bridge)
# Set by provisioning.sh from environment or use default
#RABBITMQ_URL= # Injected from secrets

# Model directory - must be pre-populated via SCP before container start
MODEL_CACHE_DIR="models_local"

# GPU enabled - A100 40GB on Vast.ai
GPU_INFERENCE_ENABLED=true
CUDA_VISIBLE_DEVICES=0

# FastAPI server (single worker)
UVICORN_HOST="0.0.0.0"
UVICORN_PORT=8002
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL="warning"

# Logging (minimal in production)
LOG_LEVEL="WARNING"
DEBUG=false
CORRELATION_ID_LOGGING=true

# Models
DEFAULT_MODEL_NAME="v1.2.0"
DEFAULT_INPUT_SIZE=1536
DEFAULT_CONFIDENCE_THRESHOLD=0.5

# Caching
MODEL_CACHE_TTL_SECONDS=3600
MODEL_CACHE_MAX_SIZE=10

# RabbitMQ Configuration
PREFETCH_COUNT=1
INFERENCE_RPC_TIMEOUT=60

# Health checks (reduced frequency in production)
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10

# Performance tuning for A100 (40GB VRAM, 40 req/s)
# Can use batch_size=2 for A100 only
INFERENCE_BATCH_SIZE=2
GPU_MEMORY_FRACTION=0.90

# Production safety
SKIP_GPU_VALIDATION=false
MOCK_INFERENCE=false
TEST_MODE=false

# Environment
ENVIRONMENT="production"
VERSION="2.0.0"

# ============================================================================
# VAST.AI SPECIFIC NOTES
# ============================================================================
# 
# Before running provisioning.sh, ensure:
# 1. RABBITMQ_URL points to your backend's RabbitMQ broker
# 2. MODEL_CACHE_DIR is created and contains v1.2.0.pt
#
# Models upload (from local machine):
#   ssh -p <SSH_PORT> root@<IP> "mkdir -p /tmp/yolo_models"
#   scp -P <SSH_PORT> v1.2.0.pt root@<IP>:/tmp/yolo_models/
#
# Container logs:
#   docker logs <container_id>
#
# Monitor GPU usage:
#   nvidia-smi -l 1
#
# ============================================================================
