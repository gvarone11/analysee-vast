# ============================================================================
# GPU Inference Service - Environment Configuration
# ============================================================================
# Copy this file to .env.local or .env.production and customize values
# ============================================================================

# ============================================================================
# RABBITMQ - Message Broker Configuration
# ============================================================================

# RABBITMQ_URL: Connection string to RabbitMQ broker
# Format: amqp://[username]:[password]@[host]:[port]/[vhost]
# 
# Local development (from Docker container on backend network):
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672/%2F"

# Local development (from host machine running GPU service locally):
# RABBITMQ_URL="amqp://guest:guest@localhost:5672/%2F"

# GPU on Vast.ai (reaching backend RabbitMQ via host.docker.internal):
# RABBITMQ_URL="amqp://guest:guest@host.docker.internal:5672/%2F"

# Production (external RabbitMQ service):
# RABBITMQ_URL="amqp://producer:SecurePassword123@rabbitmq.prod.internal:5672/production"

# Connection retry configuration (used by rabbitmq_worker.py)
RABBITMQ_CONNECTION_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=2
RABBITMQ_SOCKET_TIMEOUT=5

# Queue configuration
INFERENCE_REQUEST_QUEUE="inference_requests"
INFERENCE_RESPONSE_QUEUE="inference_responses"
INFERENCE_RPC_TIMEOUT=60

# ============================================================================
# GPU & CUDA Configuration
# ============================================================================

# MODEL_CACHE_DIR: Directory where YOLO models are stored
# Must contain: v1.2.0.pt, yolov8n.pt, etc.
# Default: /tmp/yolo_models (works in Docker and local)
MODEL_CACHE_DIR="/tmp/yolo_models"

# CUDA_VISIBLE_DEVICES: Which GPU(s) to use
# Single GPU: 0
# Multiple GPUs: 0,1,2,3
# CPU only: (leave empty or set to empty string)
CUDA_VISIBLE_DEVICES=0

# GPU Memory fraction (0.0-1.0): fraction of GPU memory to use
# Default: 0.9 (use 90% of available VRAM)
# Use less for sharing GPU with other processes
GPU_MEMORY_FRACTION=0.9

# Enable GPU inference (if False, falls back to CPU)
GPU_INFERENCE_ENABLED=true

# ============================================================================
# FastAPI Server Configuration
# ============================================================================

# UVICORN_HOST: Bind address for FastAPI server
UVICORN_HOST="0.0.0.0"

# UVICORN_PORT: Port where FastAPI listens
# Standard: 8002
UVICORN_PORT=8002

# UVICORN_WORKERS: Number of Uvicorn worker processes
# Recommendation: 1 (single GPU process, managed by entrypoint.sh)
# Do NOT increase without understanding GIL and GPU memory implications
UVICORN_WORKERS=1

# UVICORN_LOG_LEVEL: Logging level for Uvicorn
# Options: critical, error, warning, info, debug
UVICORN_LOG_LEVEL="info"

# ============================================================================
# Application Logging
# ============================================================================

# LOG_LEVEL: Logging level for application (rabbitmq_worker, inference, etc.)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# DEBUG: Enable debug mode (verbose logging, slower inference)
DEBUG=false

# CORRELATION_ID_LOGGING: Include correlation_id in all logs for tracing
CORRELATION_ID_LOGGING=true

# ============================================================================
# Model & Inference Configuration
# ============================================================================

# DEFAULT_MODEL_NAME: Which YOLO model to use if not specified in request
# Options: yolov8n, yolov8s, v1.2.0 (custom cattle detector)
DEFAULT_MODEL_NAME="v1.2.0"

# DEFAULT_INPUT_SIZE: Default YOLO input resolution
# Common: 640, 1024, 1280, 1536
# Larger = more accurate but slower
DEFAULT_INPUT_SIZE=1536

# DEFAULT_CONFIDENCE_THRESHOLD: Minimum detection confidence (0.0-1.0)
# Lower = more detections but more false positives
DEFAULT_CONFIDENCE_THRESHOLD=0.5

# ============================================================================
# Model Caching (TTL Cache Configuration)
# ============================================================================

# MODEL_CACHE_TTL_SECONDS: How long to keep models in memory
# Default: 3600 (1 hour)
# Set to 0 to disable caching (not recommended)
MODEL_CACHE_TTL_SECONDS=3600

# MODEL_CACHE_MAX_SIZE: Maximum number of models to keep in cache
# Default: 10
# Each model ~150MB, so 10 = ~1.5GB max cache
MODEL_CACHE_MAX_SIZE=10

# ============================================================================
# Health Check Configuration
# ============================================================================

# HEALTH_CHECK_INTERVAL: Seconds between health check cycles
HEALTH_CHECK_INTERVAL=30

# HEALTH_CHECK_TIMEOUT: Seconds to wait for health check response
HEALTH_CHECK_TIMEOUT=5

# ============================================================================
# Performance Tuning
# ============================================================================

# PREFETCH_COUNT: RabbitMQ prefetch count for fair dispatch
# MUST be 1 to ensure fair distribution among workers
# Do NOT change unless you understand RabbitMQ QoS
PREFETCH_COUNT=1

# INFERENCE_BATCH_SIZE: Number of images to process in parallel
# Default: 1 (sequential processing)
# Set to >1 only if GPU has 40GB+ VRAM (e.g., A100)
INFERENCE_BATCH_SIZE=1

# ============================================================================
# AWS S3 (if using external model storage instead of local files)
# ============================================================================

# AWS_ACCESS_KEY_ID: AWS credentials for S3 access (optional)
# Only needed if models are fetched from S3
# AWS_ACCESS_KEY_ID=""

# AWS_SECRET_ACCESS_KEY: AWS secret key (optional)
# AWS_SECRET_ACCESS_KEY=""

# AWS_S3_BUCKET: S3 bucket for model artifacts (optional)
# Example: my-ml-models-prod
# AWS_S3_BUCKET=""

# AWS_REGION: AWS region (optional)
# Default: us-east-1
# AWS_REGION="us-east-1"

# ============================================================================
# Development/Testing Only
# ============================================================================

# SKIP_GPU_VALIDATION: Skip GPU availability check on startup (testing only)
SKIP_GPU_VALIDATION=false

# MOCK_INFERENCE: Return fake detections without running YOLO (testing)
MOCK_INFERENCE=false

# TEST_MODE: Enable test endpoints (/test, /debug)
TEST_MODE=false

# ============================================================================
# Docker-Specific (used by entrypoint.sh)
# ============================================================================

# ENTRYPOINT_HEALTH_CHECK_ATTEMPTS: Max attempts to check FastAPI health
ENTRYPOINT_HEALTH_CHECK_ATTEMPTS=30

# ENTRYPOINT_HEALTH_CHECK_INTERVAL: Seconds between health check attempts
ENTRYPOINT_HEALTH_CHECK_INTERVAL=1

# ENTRYPOINT_PROCESS_CHECK_INTERVAL: Seconds between process alive checks
ENTRYPOINT_PROCESS_CHECK_INTERVAL=5

# ============================================================================
# Deployment Environment
# ============================================================================

# ENVIRONMENT: Current deployment environment
# Options: development, staging, production
ENVIRONMENT="development"

# VERSION: Service version (informational)
VERSION="2.0.0"

# ============================================================================
# Notes for Different Deployment Scenarios
# ============================================================================

# LOCAL DEVELOPMENT (Windows/Mac with Docker Desktop):
# ├─ RABBITMQ_URL="amqp://guest:guest@host.docker.internal:5672/%2F"
# ├─ MODEL_CACHE_DIR="/tmp/yolo_models"
# ├─ GPU_INFERENCE_ENABLED=false (use CPU for testing)
# └─ ENVIRONMENT="development"

# LOCAL GPU TESTING (with RTX 2060/3080):
# ├─ RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672/%2F"
# │  (use 'rabbitmq' hostname if on same docker network)
# ├─ GPU_INFERENCE_ENABLED=true
# ├─ CUDA_VISIBLE_DEVICES=0
# ├─ ENVIRONMENT="development"
# └─ run: docker-compose -f docker-compose.local.yml up --build

# VAST.AI PRODUCTION (GPU rental):
# ├─ RABBITMQ_URL="amqp://guest:guest@host.docker.internal:5672/%2F"
# │  (reaches backend's RabbitMQ via docker host bridge)
# ├─ MODEL_CACHE_DIR="/tmp/yolo_models"
# │  (must be populated via SCP before container start)
# ├─ GPU_INFERENCE_ENABLED=true
# ├─ CUDA_VISIBLE_DEVICES=0 (or appropriate GPU ID)
# ├─ ENVIRONMENT="production"
# └─ run: bash provisioning.sh (automates env setup + docker run)

# STAGING (A100 on AWS or Vast.ai):
# ├─ RABBITMQ_URL="amqp://producer:StrongPass@rabbitmq.staging.internal:5672/%2F"
# ├─ GPU_INFERENCE_ENABLED=true
# ├─ CUDA_VISIBLE_DEVICES=0
# ├─ ENVIRONMENT="staging"
# └─ INFERENCE_BATCH_SIZE=2 (A100 has 40GB VRAM)

# ============================================================================
