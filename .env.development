# ============================================================================
# GPU Inference Service - LOCAL DEVELOPMENT Environment
# ============================================================================
# Used for local development with docker-compose.local.yml
# ============================================================================

# RabbitMQ - connects to backend's RabbitMQ via host.docker.internal (Windows/Mac)
# or 'rabbitmq' if on same docker network
RABBITMQ_URL="amqp://guest:guest@host.docker.internal:5672/%2F"

# Model directory (shared volume or local path in docker)
MODEL_CACHE_DIR="/tmp/yolo_models"

# GPU disabled for local CPU testing (enable if you have RTX GPU)
GPU_INFERENCE_ENABLED=false
CUDA_VISIBLE_DEVICES=0

# FastAPI server
UVICORN_HOST="0.0.0.0"
UVICORN_PORT=8002
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL="debug"

# Logging
LOG_LEVEL="DEBUG"
DEBUG=true
CORRELATION_ID_LOGGING=true

# Models
DEFAULT_MODEL_NAME="v1.2.0"
DEFAULT_INPUT_SIZE=1536
DEFAULT_CONFIDENCE_THRESHOLD=0.5

# Caching
MODEL_CACHE_TTL_SECONDS=3600
MODEL_CACHE_MAX_SIZE=10

# RabbitMQ Configuration
PREFETCH_COUNT=1
INFERENCE_RPC_TIMEOUT=60

# Health checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Performance
INFERENCE_BATCH_SIZE=1
GPU_MEMORY_FRACTION=0.9

# Development/Testing
SKIP_GPU_VALIDATION=false
MOCK_INFERENCE=false
TEST_MODE=true

# Environment
ENVIRONMENT="development"
VERSION="2.0.0"
